; Install with:
;   cp deploy/project-portal.service ~/.config/systemd/user/project-portal.service
;   systemctl --user daemon-reload && systemctl --user restart project-portal
;
; %h is systemd's own specifier for the home directory of the user the unit
; runs as, so this works unedited for anyone whose checkout is at ~/project-portal.
;
; Measured on this box: SIGTERM to exit is ~0.2s and cold start to a serving
; /api/ping is ~0.5s, so a restart is well under a second of real downtime.
; These settings are about the cases where it *isn't*:
;
;   TimeoutStopSec=10  The default is 90s. Nothing currently comes close to
;                      that, but if some future background task ever refuses
;                      to unwind, this caps the outage at ten seconds instead
;                      of a minute and a half.
;   Restart=always     `on-failure` does not cover a clean-but-unintended exit,
;                      which would otherwise leave the portal simply gone.
;   RestartSec=2       The default 10s is 10s of error page after a crash.
;   OOMPolicy=continue The default is `stop`: if the kernel OOM-kills ANY
;                      process in this unit's cgroup, systemd stops the whole
;                      unit. Every agent run is a descendant of this unit, so
;                      one project's runaway `bun test` (17 GB on an 18 GB box,
;                      five times on 2026-07-26) killed the portal and orphaned
;                      every run in flight. A greedy grandchild is never a
;                      reason to stop the portal; app/runlimit.py caps the runs
;                      themselves so it should not get that far in the first
;                      place.
[Unit]
Description=Project Portal - agentic project idea tracker
After=network-online.target

[Service]
WorkingDirectory=%h/project-portal
ExecStart=%h/project-portal/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8500
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=2
TimeoutStopSec=10
OOMPolicy=continue

[Install]
WantedBy=default.target
